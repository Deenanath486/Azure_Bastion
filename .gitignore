# Local .terraform directories
**/.terraform/*
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive .tfvars files (keep terraform.tfvars.example if needed)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan output files
*.tfplan

# Lock info files created by terraform apply
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc
